# syntax=docker/dockerfile:1
#
# Headless wlroots compositor fixture for the libwldevices-go integration harness
# (see test/integration/run.sh). The base image is pinned by digest so the
# "virtual pointer and keyboard smoke green on a pinned headless compositor"
# gate is reproducible.
#
# Base image: alpine:3.21
FROM alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d

# sway          : the headless wlroots compositor under test. On this release it
#                 advertises zwlr_virtual_pointer_manager_v1 (v2) and
#                 zwp_virtual_keyboard_manager_v1 (v1) as globals.
# wayland-utils : wayland-info, useful for inspecting the compositor's globals.
# libcap        : setcap, required for the capability fix directly below.
RUN apk add --no-cache sway wayland-utils libcap

# CRITICAL: Alpine's sway binary carries the file capability cap_sys_nice=ep.
# Inside a rootless Docker daemon the container's capability bounding set does
# not include CAP_SYS_NICE, so execve() of sway fails with EPERM
# ("sway: Operation not permitted", exit code 126). Stripping the file
# capability restores a normal exec; headless pixman rendering does not need
# real-time scheduling privileges.
RUN setcap -r /usr/bin/sway

# Dedicated non-root user (uid 1000) that runs both the compositor and the
# consumer. The private 0700 XDG_RUNTIME_DIR is created up front because /run is
# root-owned and not writable by this user at container start.
RUN adduser -D -u 1000 -s /bin/sh wluser \
    && mkdir -p /run/user/1000 \
    && chown 1000:1000 /run/user/1000 \
    && chmod 700 /run/user/1000

USER wluser
WORKDIR /home/wluser
